{
  "name": {
    "en": "Wallbox Charger",
    "nl": "Wallbox Laadpaal",
    "fr": "Borne de charge Wallbox"
  },
  "class": "evcharger",
  "capabilities": [
    "locked",
    "evcharger_charging_state",
    "evcharger_charging",
    "meter_power.charged",
    "measure_current",
    "measure_power",
    "target_power",
    "target_power_mode",
    "status"
  ],
  "capabilitiesOptions": {
    "target_power": {
      "min": 0,
      "max": 22000,
      "step": 230,
      "excludeMin": 0,
      "excludeMax": 1380
    }
  },
  "energy": {
    "evCharger": true,
    "meterPowerImportedCapability": "meter_power.charged"
  },
  "images": {
    "xlarge": "/drivers/wallbox/assets/images/xlarge.png",
    "large": "/drivers/wallbox/assets/images/large.png",
    "small": "/drivers/wallbox/assets/images/small.png"
  },
  "icon": "/drivers/wallbox/assets/icon.svg",
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "logo": "icon.png",
        "usernameLabel": {
          "en": "E-mail address",
          "nl": "E-mail adres",
          "fr": "Adresse Email"
        },
        "usernamePlaceholder": {
          "en": "john@doe.com",
          "nl": "john@doe.com",
          "fr": "john@doe.com"
        },
        "passwordLabel": {
          "en": "Password",
          "nl": "Wachtwoord",
          "fr": "Mot de passe"
        },
        "passwordPlaceholder": {
          "en": "Password",
          "nl": "Wachtwoord",
          "fr": "Mot de passe"
        }
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      },
      "options": {
        "singular": true
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
